# LLM API Configuration (Grok, OpenAI, or local model like Ollama / LM Studio / vLLM)
# For Grok: LLM_BASE_URL=https://api.x.ai/v1 , LLM_MODEL_NAME=grok-2-latest
# For Local (Ollama): LLM_BASE_URL=http://localhost:11434/v1 , LLM_MODEL_NAME=llama3
# For Local (LM Studio): LLM_BASE_URL=http://localhost:1234/v1 , LLM_MODEL_NAME=local-model
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=grok-2-latest

# SQLite Database
DATABASE_URL=sqlite:///./learning_path.db
PORT=8000

